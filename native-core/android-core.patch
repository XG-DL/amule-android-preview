 	const wxLongLong prefsStart = wxGetUTCTimeMillis();
 #endif
 	glob_prefs = new CPreferences();
+#ifdef __ANDROID__
+	// Android's system CA certificates are stored as individual DER files. The
+	// bundled libcurl/OpenSSL build needs them combined into a PEM bundle.
+	{
+		wxString configuredBundle;
+		if (!wxGetEnv("CURL_CA_BUNDLE", &configuredBundle) || configuredBundle.IsEmpty()) {
+			const wxString bundlePath = thePrefs::GetConfigDir() + "android-ca-bundle.pem";
+			const Unicode2CharBuf bundlePathUtf8 = unicode2char(bundlePath);
+			std::ofstream bundle(static_cast<const char *>(bundlePathUtf8), std::ios::binary | std::ios::trunc);
+			DIR *certDir = opendir("/system/etc/security/cacerts");
+			bool complete = bundle.is_open() && certDir;
+			if (complete) {
+				while (dirent *entry = readdir(certDir)) {
+					if (entry->d_name[0] == '.') {
+						continue;
+					}
+					const std::string certPath = std::string("/system/etc/security/cacerts/") + entry->d_name;
+					std::ifstream cert(certPath, std::ios::binary);
+					if (!cert.is_open()) {
+						complete = false;
+						break;
+					}
+					bundle << cert.rdbuf() << '\n';
+					if (!bundle.good()) {
+						complete = false;
+						break;
+					}
+				}
+				closedir(certDir);
+			}
+			bundle.close();
+			if (complete && bundle.good()) {
+				wxSetEnv("CURL_CA_BUNDLE", bundlePath);
+			} else {
+				wxRemoveFile(bundlePath);
+				AddLogLineC(CFormat("Could not create Android CA bundle from %s; HTTPS downloads may fail.") % "/system/etc/security/cacerts");
+			}
+		}
+	}
+#endif
 #ifdef AMULE_SHOW_SPLASH
 	const wxLongLong prefsDoneAt = wxGetUTCTimeMillis();
 #endif
